rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.type is string && (data.type == 'income' || data.type == 'expense') &&
             data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('wallet' in data) || (data.wallet is string && data.wallet.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidBudget(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.month is string && data.month.size() == 7 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 128 &&
             data.limitAmount is number && data.limitAmount >= 0 && data.limitAmount <= 1000000000 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Connection test document
    match /test/connection {
      allow read: if isSignedIn();
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(request.resource.data, userId) &&
                       request.resource.data.keys().hasAll(['userId', 'email']) &&
                       request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(request.resource.data, userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) &&
                         isValidTransaction(request.resource.data, userId) &&
                         request.resource.data.keys().hasAll(['userId', 'type', 'amount', 'category', 'date']) &&
                         request.resource.data.keys().hasOnly(['userId', 'type', 'amount', 'category', 'date', 'note', 'wallet', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) &&
                         isValidTransaction(request.resource.data, userId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'amount', 'category', 'date', 'note', 'wallet', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) &&
                         isValidBudget(request.resource.data, userId) &&
                         request.resource.data.keys().hasAll(['userId', 'month', 'category', 'limitAmount']) &&
                         request.resource.data.keys().hasOnly(['userId', 'month', 'category', 'limitAmount', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) &&
                         isValidBudget(request.resource.data, userId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['month', 'category', 'limitAmount', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(budgetId);
      }
    }
  }
}
